<div class="max-w-md mx-auto mt-12">

  <h1 class="text-3xl font-bold mb-6">
    Log In
  </h1>

  <%= tag.div(flash[:alert],
      class: "mb-4 rounded bg-red-100 border border-red-300 p-3 text-red-800") if flash[:alert] %>

  <%= form_with url: session_path, class: "space-y-5" do |form| %>

    <div>
      <%= form.label :email_address,
          class: "block mb-1 font-medium" %>

      <%= form.email_field :email_address,
          required: true,
          autofocus: true,
          autocomplete: "username",
          placeholder: "Email address",
          value: params[:email_address],
          class: "border rounded-lg w-full p-3 bg-white" %>
    </div>


    <div>
      <%= form.label :password,
          class: "block mb-1 font-medium" %>

      <%= form.password_field :password,
          required: true,
          autocomplete: "current-password",
          placeholder: "Password",
          maxlength: 72,
          class: "border rounded-lg w-full p-3 bg-white" %>
    </div>


    <%= form.submit "Log In",
        class: "w-full rounded-lg bg-emerald-600 text-white px-6 py-3 hover:bg-emerald-700" %>

  <% end %>


  <div class="mt-6 text-center">
    <%= link_to "Forgot password?",
        new_password_path,
        class: "text-stone-600 hover:text-stone-900" %>
  </div>

</div>
