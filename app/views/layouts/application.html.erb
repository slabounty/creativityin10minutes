<!DOCTYPE html>
<html>
  <head>
    <title>Creativity in 10 Minutes</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-stone-100 min-h-screen text-stone-900">
    <header class="bg-white border-b shadow-sm">
      <div class="max-w-5xl mx-auto px-6 py-4 flex justify-between items-center">

        <%= link_to root_path,
            class: "text-2xl font-bold text-emerald-700" do %>
          Creativity in 10 Minutes
        <% end %>

        <nav class="flex items-center gap-3">
          <% if authenticated? %>

            <%= link_to "Today's Prompt",
                home_path,
                class: "rounded-lg bg-emerald-600 text-white px-4 py-2 hover:bg-emerald-700 transition-colors" %>

            <%= button_to "Log Out",
                session_path,
                method: :delete,
                class: "rounded-lg bg-stone-200 px-4 py-2 hover:bg-stone-300 transition-colors" %>

          <% else %>

            <%= link_to "Sign Up",
                new_user_path,
                class: "rounded-lg bg-emerald-600 text-white px-4 py-2 hover:bg-emerald-700 transition-colors" %>

            <%= link_to "Log In",
                new_session_path,
                class: "rounded-lg bg-stone-200 px-4 py-2 hover:bg-stone-300 transition-colors" %>

          <% end %>
        </nav>

      </div>
    </header>

    <main class="max-w-5xl mx-auto px-6 py-10">
      <%= yield %>
    </main>
  </body>
</html>
